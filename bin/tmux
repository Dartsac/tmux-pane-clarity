#!/bin/sh
# Pane-clarity tmux adapter. Only pane layout/navigation commands start the
# engine (which still passes through unless the target window is
# always-framed); everything else is exec'd straight to the real tmux. Never replace the real
# tmux binary with this file.
self=$0
# Whether $1 is a pane clarity adapter: this one, or another copy's (every
# copy has tmux-pane-clarity.tmux beside bin/), also through a symlink to the
# file itself. As the "real" tmux, one would exec itself or the other forever
# (same PID, so nothing ever exits), or start a second engine that waits on
# this one's lock.
is_adapter() {
  [ "$1" -ef "$self" ] && return 0
  file=$1 hops=0
  while [ -L "$file" ] && [ "$hops" -lt 40 ]; do
    # Not only from PATH, which may hold nothing but adapters.
    link=$( { /usr/bin/readlink "$file" || /bin/readlink "$file" || readlink "$file"; } 2>/dev/null ) || break
    case $link in /*) file=$link ;; *) file=${file%/*}/$link ;; esac
    hops=$((hops + 1))
  done
  [ -f "${file%/*}/../tmux-pane-clarity.tmux" ]
}
real=${PANE_CLARITY_REAL_TMUX:-}
if [ -n "$real" ] && is_adapter "$real"; then
  real=  # search PATH instead
fi
if [ -z "$real" ]; then
  set -f; old_ifs=$IFS; IFS=:
  for dir in $PATH; do
    # Relative entries (e.g. "bin") resolve against the cwd and can land on
    # this adapter, so only absolute directories are considered.
    case $dir in /*) ;; *) continue ;; esac
    if [ -x "$dir/tmux" ] && ! is_adapter "$dir/tmux"; then
      real=$dir/tmux; break
    fi
  done
  IFS=$old_ifs; set +f
fi
if [ -z "$real" ]; then
  echo "pane-clarity: cannot find the real tmux binary (only pane clarity adapters on PATH)" >&2
  exit 127
fi

command= skip= direction=
for arg do
  if [ -n "$command" ]; then
    case $arg in -[LRUDl]) direction=1 ;; esac
  elif [ -n "$skip" ]; then
    skip=
  else
    case $arg in
      -[LSfTc]) skip=1 ;;  # global option taking a value
      -*) ;;
      *) command=$arg ;;
    esac
  fi
done

case $command in
  select-pane|selectp) [ -n "$direction" ] || exec "$real" "$@" ;;
  split-window|splitw|resize-pane|resizep|select-layout|selectl|next-layout|nextl) ;;
  last-pane|lastp|rotate-window|rotatew|swap-pane|swapp|kill-pane|killp) ;;
  *) exec "$real" "$@" ;;
esac
# The Rust engine; until it is built, managed commands pass through unchanged.
engine=${self%/*}/../target/release/pane-clarity
[ -x "$engine" ] || exec "$real" "$@"
PANE_CLARITY_REAL_TMUX=$real exec "$engine" tmux "$@"
